{
  "name": "cartridge-launcher",
  "productName": "Fulton",
  "version": "1.85.0",
  "description": "Fulton: Your home base for recomps, decomps and remakes. A launcher for decompiled and recompiled retro game ports. Bring your ROMs, it does the rest.",
  "main": "main.js",
  "cartridge": {
    "kofi": "https://ko-fi.com/triwind",
    "repo": "TriwindBryan/fulton",
    "itch": "",
    "label": "Beta 0.0052"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir",
    "dist:msi": "electron-builder --win msi",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.9.1"
  },
  "build": {
    "appId": "com.cartridge.launcher",
    "productName": "Fulton",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "CHANGELOG.md",
      "src/**/*",
      "renderer/**/*",
      "catalog/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "build/icon-mac.png"
    ],
    "asarUnpack": [
      "src/core/rom.js",
      "src/core/inspect-worker.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "msi"
      ]
    },
    "portable": {
      "artifactName": "Fulton-${version}-Portable.exe"
    },
    "msi": {
      "artifactName": "Fulton-${version}-Setup.msi",
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fulton",
      "upgradeCode": "6f3c2b1e-7a4d-4c8e-9b21-c4a7d2e5f091",
      "warningsAsErrors": false
    },
    "msiProjectCreated": "build/msi-hook.js",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Fulton-${version}-${arch}.dmg",
      "title": "Fulton ${version}",
      "icon": "build/icon.icns"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "Launcher for decomp, recomp and remake PC ports",
      "executableName": "fulton",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "Fulton-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Fulton",
          "Comment": "Launcher for decomp, recomp and remake PC ports",
          "Categories": "Game;",
          "Keywords": "games;recomp;decomp;launcher;"
        }
      }
    }
  },
  "author": "TriwindBryan",
  "homepage": "https://github.com/TriwindBryan/fulton",
  "repository": {
    "type": "git",
    "url": "https://github.com/TriwindBryan/fulton.git"
  }
}
